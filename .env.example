# ── Apify ──────────────────────────────────────────────────────────────
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=your_username/plugin-watcher   # e.g. jordaaan/plugin-watcher

# ── Cloudflare ─────────────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id       # created during Phase 2
WEBHOOK_SECRET=generate_a_random_secret_here  # used to validate incoming webhooks

# ── Anthropic (haiku self-eval gate) ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Output Paths ────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/Users/supabowl/Library/Mobile Documents/com~apple~CloudDocs/BHT Promo iCloud/Organized AI/Obsidian Vault
PLUGIN_MARKETPLACE_PATH=/Users/supabowl/Documents/repos/plugin-marketplace

# ── Meta Ads API (enriched snapshot) ───────────────────────────────────
META_ACCESS_TOKEN=your_meta_system_user_token   # long-lived token with ads_read permission
META_AD_ACCOUNT_ID=act_645790768357540          # ad account ID (with act_ prefix)
META_PIXEL_ID=1029907382331846                  # pixel ID for CAPI/EMQ diagnostics
META_ACCOUNT_NAME=HRE Beauty                   # display name for logs

# ── Google Ads API (enriched snapshot) ─────────────────────────────────
GOOGLE_ADS_CUSTOMER_ID=1234567890               # customer ID (digits only, no dashes)
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token # required for all Google Ads API calls
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id       # OAuth2 client ID
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token     # OAuth2 refresh token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=                   # optional, for MCC (manager account) access

# ── Thresholds (tunable) ────────────────────────────────────────────────
SIGNIFICANCE_MIN_TOOL_USE=15       # min tool_use events to be "significant"
ADJACENCY_MIN_FINAL_SCORE=4.0     # min score to enter experiment queue
HAIKU_MIN_RELEVANCE_SCORE=6       # min haiku score to generate outputs
DEBOUNCE_SECONDS=300              # min seconds between pipeline runs
