# ── Apify ──────────────────────────────────────────────────────────────
APIFY_TOKEN=your_apify_token_here
APIFY_ACTOR_ID=your_username/plugin-watcher   # e.g. jordaaan/plugin-watcher

# ── Cloudflare ─────────────────────────────────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_api_token
CF_KV_NAMESPACE_ID=6f5fb8b431b246fa9204459e5543df80   # GTM_AUTORESEARCH_VERSIONS — GTM container version history
WEBHOOK_SECRET=generate_a_random_secret_here  # used to validate incoming webhooks

# ── Anthropic (haiku self-eval gate) ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Output Paths ────────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=/Users/supabowl/Library/Mobile Documents/com~apple~CloudDocs/BHT Promo iCloud/Organized AI/Obsidian Vault
PLUGIN_MARKETPLACE_PATH=/Users/supabowl/Documents/repos/plugin-marketplace

# ── Thresholds (tunable) ────────────────────────────────────────────────
SIGNIFICANCE_MIN_TOOL_USE=15       # min tool_use events to be "significant"
ADJACENCY_MIN_FINAL_SCORE=4.0     # min score to enter experiment queue
HAIKU_MIN_RELEVANCE_SCORE=6       # min haiku score to generate outputs
DEBOUNCE_SECONDS=300              # min seconds between pipeline runs
