{
  "name": "@organized-ai/autoresearch-in-a-box",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": { "arb": "cli/arb.mjs" },
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node cli/arb.mjs check all --why",
