{
  // GTM Container Atlas: the audit page as Worker Assets, plus drift watch (D1 + daily cron) and Jev verdicts through jev-gateway (secret JEV_GATEWAY_TOKEN, or JEV_KEY for the hosted atlas).
  // 1) npx wrangler d1 create gtm-container-atlas   2) paste the database_id below   3) npx wrangler queues create atlas-site-scan   4) npm run db:init   5) npm run deploy
  // To serve on your own domain, add: "routes": [{ "pattern": "atlas.example.com", "custom_domain": true }]
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtm-container-atlas",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "gtm-container-atlas", "database_id": "REPLACE_WITH_YOUR_D1_ID" }],
  // Jev: every call goes through jev-gateway. Get a hosted key (free for 30 days) from
  // POST https://atlas.organizedai.vip/api/jev/trial and run `npx wrangler secret put JEV_KEY`.
  // Site scan: crawls page source through this queue (Workers Paid). Without the queue binding the Worker crawls inline.
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "atlas-site-scan" }],
    "consumers": [{ "queue": "atlas-site-scan", "max_batch_size": 4, "max_batch_timeout": 2, "max_retries": 1, "max_concurrency": 3 }]
  },
  "triggers": { "crons": ["17 11 * * *"] },
  "vars": { "TRIAL_DAYS": "30", "SCAN_MAX_PAGES": "50", "SCAN_DAILY": "30" },
  "observability": { "enabled": true }
}
